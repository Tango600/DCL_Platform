            </SyntaxOptions>
          </Parsing>
          <CodeGeneration>
            <TargetProcessor Value="pentium2"/>
            <TargetCPU Value="i386"/>
            <TargetOS Value="win32"/>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <DebugInfoType Value="dsDwarf3"/>
              <UseExternalDbgSyms Value="True"/>
            </Debugging>
            <Options>
              <Win32>
                <GraphicApplication Value="True"/>
              </Win32>
            </Options>
          </Linking>
          <Other>
            <CompilerMessages>
              <IgnoredMessages idx6058="True"/>
            </CompilerMessages>
            <ExecuteBefore>
              <Command Value="$(LazarusDir)\tools\svn2revisioninc$(ExeExt) $(ProjPath) $(ProjPath)\data\revision.inc"/>
            </ExecuteBefore>
          </Other>
        </CompilerOptions>
      </Item>
